          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Nivel: Stock bajo\n"
          ]
        }
      ],
      "execution_count": 1,
      "source": [
        "cantidad_en_stock = 3\n",
        "\n",
        "if cantidad_en_stock == 0:\n",
        "    nivel = \"Agotado\"\n",
        "elif cantidad_en_stock < 5:\n",
        "    nivel = \"Stock bajo\"\n",
        "else:\n",
        "    nivel = \"Stock suficiente\"\n",
        "\n",
        "print(\"Nivel:\", nivel)"
      ]
